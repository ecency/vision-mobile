<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. See backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ecency.secure.xml" />
        <exclude domain="database" path="RKStorage" />
        <!-- Local drafts (unpublished text). Camera captures live in the cache folder, which is never backed up or transferred. -->
        <exclude domain="file" path="drafts/" />
        <!-- the widgets\' snapshot belongs to this device\'s session (README "Widgets") -->
        <exclude domain="sharedpref" path="ecency.widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ecency.secure.xml" />
        <exclude domain="database" path="RKStorage" />
        <!-- Local drafts (unpublished text). Camera captures live in the cache folder, which is never backed up or transferred. -->
        <exclude domain="file" path="drafts/" />
        <!-- the widgets\' snapshot belongs to this device\'s session (README "Widgets") -->
        <exclude domain="sharedpref" path="ecency.widgets.xml" />
    </device-transfer>
</data-extraction-rules>
