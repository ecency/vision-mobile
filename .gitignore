# Generated by XcodeGen from iosApp/project.yml
iosApp/*.xcodeproj/
iosApp/EcencyApp/Info.plist
iosApp/ShareExtension/Info.plist
# Kotlin and Gradle
.gradle/
.kotlin/
build/
local.properties
# Never commit app secrets or signing material
google-services.json
GoogleService-Info.plist
*.jks
*.keystore
*.p12
*.mobileprovision
.env*
# Build secrets generated from local.properties for the iOS app
iosApp/Generated/
# gradle.properties holds build settings only and CI needs it. Never put secrets in it, use
# ~/.gradle/gradle.properties.
!gradle.properties

# Material Symbols download cache (scripts/icons/material_symbols.py)
scripts/icons/.cache/

# Editors and OS
.claude/settings.local.json
.DS_Store
.idea/
.vscode/
*.iml

# The golden generators' npm packages (tools/package.json)
node_modules/

# Left behind by the React Native 3.x app (removed; see the rn-3.x-final tag) in older checkouts
/android/
/ios/
/vendor/
